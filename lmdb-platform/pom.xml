<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.dfa1.lmdb</groupId>
		<artifactId>lmdb-ffm</artifactId>
		<version>0.3-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>lmdb-platform</artifactId>
	<name>lmdb-platform</name>
	<description>lmdb-ffm bindings bundled with every platform's native library</description>
	<!-- Empty convenience jar (no sources of its own): a single, ordinary jar
	     dependency that transitively pulls everything. jar packaging (not pom) so
	     clients can add it like any normal artifact. -->
	<packaging>jar</packaging>

	<!-- One dependency pulls the bindings plus every native library shipped
	     (osx/linux/windows, x86_64/aarch64), so a build runs on any supported
	     OS/arch without choosing a classifier. For a known single target
	     depend on lmdb + the one lmdb-native-<classifier> directly. Versions
	     come from the parent's dependencyManagement.

	     Default (compile) scope, not runtime: this module's own module-info.java
	     `requires` each native module by name (so it's pulled into the resolved
	     module graph for module-path consumers — see that file), and javac only
	     puts compile-scoped dependencies on the module path it resolves `requires`
	     against. None of them export any package, so compile scope leaks no API
	     surface a classpath consumer could actually reference either way. -->
	<dependencies>
		<dependency>
			<groupId>io.github.dfa1.lmdb</groupId>
			<artifactId>lmdb</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.dfa1.lmdb</groupId>
			<artifactId>lmdb-native-osx-aarch64</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.dfa1.lmdb</groupId>
			<artifactId>lmdb-native-osx-x86_64</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.dfa1.lmdb</groupId>
			<artifactId>lmdb-native-linux-x86_64</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.dfa1.lmdb</groupId>
			<artifactId>lmdb-native-linux-aarch64</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.dfa1.lmdb</groupId>
			<artifactId>lmdb-native-windows-x86_64</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.dfa1.lmdb</groupId>
			<artifactId>lmdb-native-windows-aarch64</artifactId>
		</dependency>
	</dependencies>
</project>
